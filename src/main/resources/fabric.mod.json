{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "gleam.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.thatmaidenjaden.gleam.Gleam"
    ],
    "client": [
      "net.thatmaidenjaden.gleam.GleamClient"
    ],
    "modmenu": [
      "net.thatmaidenjaden.gleam.config.screen.ModMenuCompat"
    ]
  },
  "accessWidener": "gleam.accesswidener",
  "mixins": [
    "gleam.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}